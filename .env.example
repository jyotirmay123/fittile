# Client-side (safe to ship in the browser bundle; protected by Row Level Security)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only. NEVER prefix these with VITE_ or they get bundled into the client.
SUPABASE_SECRET_KEY=server-secret-only
SUPABASE_PROJECT_PASSWORD=server-secret-only
OPENAI_API_KEY=server-secret-only
USDA_API_KEY=server-secret-only
